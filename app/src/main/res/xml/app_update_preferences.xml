<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.deniscerri.ytdl.ui.more.settings.updating.UpdateStatusCardPreference
        app:key="app_status_card" />

    <PreferenceCategory
        app:key="app_update_channel_category"
        android:title="@string/update_channel">

        <com.deniscerri.ytdl.ui.more.settings.updating.UpdateChannelPreference
            app:key="app_channel" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings">

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/ic_update_app"
            android:key="update_app"
            app:summary="@string/update_app_summary"
            app:title="@string/update_app" />

        <EditTextPreference
            app:isPreferenceVisible="false"
            app:key="skip_updates"
            app:defaultValue="" />

        <SwitchPreferenceCompat
            app:isPreferenceVisible="false"
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:key="update_beta" />

        <Preference
            app:icon="@drawable/ic_chapters"
            app:key="changelog"
            app:title="@string/changelog" />

    </PreferenceCategory>

    <Preference
        app:icon="@drawable/baseline_reset_tv_24"
        app:key="reset_preferences"
        android:summary="@string/reset_preferences_in_screen"
        app:title="@string/reset" />

</PreferenceScreen>
